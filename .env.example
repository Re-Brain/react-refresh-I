# Copy this file to .env (gitignored — every developer creates their own,
# it's never committed) and fill in real values.
#
# Vite only exposes variables prefixed with VITE_ to frontend code
# (import.meta.env.*) — any new variable meant to be read in the browser
# must keep that prefix or it will be undefined at runtime.

# Origin of the FastAPI backend. Must match the exact hostname the backend
# sets its auth cookies for (localhost, not 127.0.0.1 — the browser treats
# those as different hosts even though both resolve to loopback).
# Local dev value: http://localhost:8000
VITE_API_URL=
